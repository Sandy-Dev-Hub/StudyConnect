# =============================================================================
# StudyConnect — Example Environment Variables
# Copy this file to .env and fill in real values for local development.
# NEVER commit .env to git — it is git-ignored.
# On Render, set these via the dashboard or render.yaml (sync: false).
# =============================================================================

# Flask
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=change-me-to-a-64-char-random-hex-string

# Database (PostgreSQL via pg8000)
# For local dev: use a direct connection or local Postgres
# For production (Render): use the Supabase Session Pooler URL with pg8000 prefix.
# Get it from: Supabase Dashboard → Project Settings → Database → Connection pooling → Session mode
# Format: postgresql+pg8000://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql+pg8000://postgres:password@localhost:5432/studyconnect

# Redis (leave empty to use SimpleCache fallback for local dev)
REDIS_URL=redis://localhost:6379/0

# Mail — SMTP via Flask-Mail
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=1
MAIL_USE_SSL=0
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-gmail-app-password
MAIL_DEFAULT_SENDER=StudyConnect <your-email@gmail.com>
# Set to 1 to suppress sending (prints to console instead). Set to 0 in production.
MAIL_SUPPRESS_SEND=1

# Optional: Brevo transactional email API (alternative to SMTP)
# BREVO_API_KEY=

# User management
# Set AUTO_VERIFY_USERS=1 only in DEBUG mode to skip email verification locally
AUTO_VERIFY_USERS=0

# Gunicorn tuning (optional overrides — defaults work fine for most deployments)
# GUNICORN_WORKERS=1
# GUNICORN_TIMEOUT=120
# GUNICORN_LOG_LEVEL=info

# Upload
MAX_CONTENT_LENGTH=5242880
UPLOAD_FOLDER=app/static/uploads
